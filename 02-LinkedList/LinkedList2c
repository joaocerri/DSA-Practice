#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int value;
    struct Node *next;
} Node;

typedef struct List {
    Node *head;
} List;

void insertFirst(List *list, int value) {
    Node *newNode = malloc(sizeof(Node));

    if (newNode == NULL) {
        return;
    }

    newNode->value = value;
    newNode->next = list->head;

    list->head = newNode;
}

void insertEnd(List *list, int value) {
    Node *newNode = malloc(sizeof(Node));

    if (newNode == NULL) {
        return;
    }

    newNode->value = value;
    newNode->next = NULL;

    if (list->head == NULL) {
        list->head = newNode;
        return;
    }

    Node *current = list->head;

    while (current->next != NULL) {
        current = current->next;
    }

    current->next = newNode;
}

void printList(List *list) {
    Node *current = list->head;
    int counter = 1;

    if (current == NULL) {
        printf("\nThe list is empty.");
        return;
    }

    while (current != NULL) {
        printf("\nValue in this position %d: %d",
               counter, current->value);

        current = current->next;
        counter++;
    }
}

void deleteFirst(List *list) {
    if (list->head == NULL) {
        return;
    }

    Node *aux = list->head;

    list->head = list->head->next;

    free(aux);
}

void delete(List *list, int value) {
    Node *current = list->head;
    Node *previous = NULL;

    while (current != NULL && current->value != value) {
        previous = current;
        current = current->next;
    }

    if (current == NULL) {
        return;
    }

    if (previous == NULL) {
        list->head = current->next;
    } else {
        previous->next = current->next;
    }

    free(current);
}

int main() {

    List list;

    list.head = NULL;

    insertFirst(&list, 20);
    insertFirst(&list, 30);
    insertEnd(&list, 60);
    insertEnd(&list, 100);
    insertFirst(&list, 99);

    printf("First List:");
    printList(&list);

    delete(&list, 20);

    printf("\n\nAfter delete 20:");
    printList(&list);

    deleteFirst(&list);

    printf("\n\nAfter delete first element:");
    printList(&list);

    delete(&list, 60);

    printf("\n\nAfter delete 60:");
    printList(&list);

    delete(&list, 100);

    printf("\n\nAfter delete 100:");
    printList(&list);

    return 0;
}